{
  "name": "@northline/storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Northline Storybook: components, Foundations and pages, with a brand and theme toolbar.",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
