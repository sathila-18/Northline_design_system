{
  "name": "@northline/tokens",
  "version": "0.0.0",
  "description": "Northline design tokens: CSS variables, TypeScript constants and the Tailwind theme, built from tokens/design.tokens.json.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/tokens.js",
  "types": "./dist/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tailwind-theme.css": "./dist/tailwind-theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node build.ts && vitest run"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.5",
    "style-dictionary": "5.8.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
