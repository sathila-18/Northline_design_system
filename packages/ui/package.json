{
  "name": "@northline/ui",
  "version": "0.0.0",
  "description": "Northline React components, styled with Tailwind CSS 4 and the Northline tokens.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.js"
    },
    "./index.css": "./dist/index.css"
  },
  "scripts": {
    "icons": "node scripts/subset-icons.mjs",
    "build": "pnpm icons && vite build && vite build --config vite.styles.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm icons && vitest run && node scripts/check-directives.mjs && node scripts/check-styles.mjs"
  },
  "peerDependencies": {
    "@northline/tokens": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "3.10.1",
    "react-is": "^19.0.0"
  },
  "devDependencies": {
    "@northline/tokens": "workspace:^",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "material-symbols": "0.49.0"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    },
    "react-is": {
      "optional": true
    }
  }
}
